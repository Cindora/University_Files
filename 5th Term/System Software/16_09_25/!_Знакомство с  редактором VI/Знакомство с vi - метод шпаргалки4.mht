	border:1px solid #CCC;
	border-top:0px;
/* 6.0 Maverick IU1 jpp-egd 03-06-09:  Added space after bottom of table for readability */
    margin-bottom:8px;
	width:100%;
}
#ibm-content-main table.data-table-1 caption {font-size:0.75em;}
